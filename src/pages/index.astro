---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { slugify } from '../utils/slugify';
import { getBlogSources, getSourceInfo } from '../utils/sourceHelper';

const excludedFeedSlugs = new Set(['about', 'contact', 'gabung-komunitas', 'vibe-coding', 'wordpress-plugins', 'jquery-plugins']);

const allPosts = (await getCollection('posts'))
  .filter((p) => {
    const isPage = p.data.format === 'page' || (p.data as any).type === 'page';
    const cleanSlug = p.data.slug.replace(/^\//, '').replace(/\/$/, '');
    return Boolean(p.data.date && p.data.date.trim().length > 0 && !isPage && !excludedFeedSlugs.has(cleanSlug));
  })
  .sort((a, b) => {
    return (a.data.date || '').localeCompare(b.data.date || '');
  });

const totalPosts = allPosts.length;
const totalComments = allPosts.reduce((acc, p) => acc + (p.data.comments?.length || 0), 0);

// Group posts by Year
const postsByYear: Record<string, any[]> = {};
allPosts.forEach((post) => {
  const year = post.data.date ? post.data.date.slice(0, 4) : 'Lainnya';
  if (!postsByYear[year]) {
    postsByYear[year] = [];
  }
  postsByYear[year].push(post);
});

const sortedYears = Object.keys(postsByYear).sort((a, b) => a.localeCompare(b));

// Sources present per year
const yearSources: Record<string, string[]> = {};
const yearHasTimeline: Record<string, boolean> = {};

sortedYears.forEach((year) => {
  const sourcesSet = new Set<string>();
  let hasTimeline = false;
  postsByYear[year].forEach((post) => {
    if (post.data.isTimeline) {
      hasTimeline = true;
    }
    sourcesSet.add(getSourceInfo(post.data.source).slug);
  });
  yearSources[year] = Array.from(sourcesSet);
  yearHasTimeline[year] = hasTimeline;
});

// Source counts computed using canonical slug
const sourceCounts: Record<string, number> = {};
allPosts.forEach((p) => {
  const info = getSourceInfo(p.data.source);
  sourceCounts[info.slug] = (sourceCounts[info.slug] || 0) + 1;
});

const blogSources = getBlogSources();

const categoryCounts: Record<string, number> = {};
allPosts.forEach((p) => {
  p.data.categories?.forEach((c: string) => {
    categoryCounts[c] = (categoryCounts[c] || 0) + 1;
  });
});
const popularCategories = Object.entries(categoryCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 7);
---

<BaseLayout
  title="napak tilas jejak digital - my blog restoration"
  description="Arsip restorasi blog takien.com (2006-2016) — Tutorial web design, WordPress, PHP, JavaScript, dan pemrograman."
>
  <div class="content-container">
    <!-- Hero Banner -->
    <div style="background: linear-gradient(135deg, var(--bg-card), var(--bg-hover)); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2.25rem 2rem; margin-bottom: 2.25rem;">
      <div style="max-width: 720px;">
        <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.6rem;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent);"></span>
          napak tilas jejak digital
        </span>
        <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; margin-bottom: 0.85rem; color: var(--text-primary);">
          selamat datang di blog hasil restorasi
        </h1>
        <div class="md:flex md:space-x-2 mb-10">
        <img class="md:w-1/2"   src="/images/uploads/1788770766155_ilustrasi-jejak-digital.jpg" alt="jejak digital" />
        <div class="md:w-1/2">
        <p>
        Website ini berisi tulisanku dari jaman dulu yang pernah kupublikasikan di Internet dan yang berhasil aku kumpulkan lagi. Aku aktif ngeblog dari tahun 2006 sampai 2016. Nyaris eh tepat 10 tahun. Setelah itu masih nulis juga tapi di Facebook Notes, group maupun di status. Sudah 10 tahun juga sampai sekarang (2026). Sepertinya aku bakalan nulis lagi di sini. <a href="/about/" style="font-weight: 600; text-decoration: underline;">Selengkapnya</a>.</p></div>
        </div>

        <!-- Stats Chips -->
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    
             <a href="/archives/" class="flex items-center gap-[0.4rem] text-[0.85rem] text-[var(--text-secondary)] font-medium bg-[var(--bg-card)] px-3 py-[0.35rem] rounded-[var(--radius-full)] border-2 border-solid border-[var(--border)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span><strong>{totalPosts}</strong> Konten</span>
            </a>
 
          <a href="/archives/" class="flex items-center gap-[0.4rem] text-[0.85rem] text-[var(--text-secondary)] font-medium bg-[var(--bg-card)] px-3 py-[0.35rem] rounded-[var(--radius-full)] border-2 border-solid border-[var(--border)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span><strong>{totalComments}</strong> Komentar</span>
            </a>
           

          <a href="/archives/" class="flex items-center gap-[0.4rem] text-[0.85rem] text-[var(--text-secondary)] font-medium bg-[var(--bg-card)] px-3 py-[0.35rem] rounded-[var(--radius-full)] border-2 border-solid border-[var(--border)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span><strong>2006 &ndash; 2026</strong> (20 Tahun)</span>
            </a>
           

          <a href="/archives/" class="flex items-center gap-[0.4rem] text-[0.85rem] text-[var(--text-secondary)] font-medium bg-[var(--bg-card)] px-3 py-[0.35rem] rounded-[var(--radius-full)] border-2 border-solid border-[var(--border)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span><strong>{blogSources.length}</strong> Blog & Sumber</span>
            </a>
           
        </div>
      </div>
    </div>

    <!-- Section: Koleksi & Sumber (Card Kecil seperti Sidebar) -->
    <div style="margin-bottom: 2.25rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.55rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <h2 style="font-size: 1.25rem; font-weight: 700; letter-spacing: -0.015em; margin: 0;">
            Blog & Sumber Koleksi
          </h2>
        </div>
        <a href="/archives/" style="font-size: 0.84rem; font-weight: 600; color: var(--accent);">
          Lihat Seluruh Timeline &rarr;
        </a>
      </div>

      <div class="home-sources-grid">
        {blogSources.map((item) => {
          const count = sourceCounts[item.slug] || 0;
          return (
            <a
              href={`/source/${item.slug}/`}
              class="blog-chip"
              style={`--chip-color: ${item.color};`}
              title={`${item.description} (${item.period})`}
            >
              <div class="blog-chip-header">
                <span class={`source-dot ${item.dotClass}`}></span>
                <span class="blog-chip-name">{item.name}</span>
              </div>
              <span class="blog-chip-note">
                {item.period} &bull; {count} post
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Category Pills -->
    {popularCategories.length > 0 && (
      <div style="margin-bottom: 2rem; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;">
        <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">
          Kategori:
        </span>
        {popularCategories.map(([cat, count]) => (
          <a
            href={`/categories/${slugify(cat)}/`}
            style="font-size: 0.82rem; padding: 0.25rem 0.7rem; border-radius: var(--radius-full); border: 1px solid var(--border); color: var(--text-secondary); background-color: var(--bg-card); transition: all 0.15s ease;"
          >
            {cat} <span style="opacity: 0.6; font-size: 0.74rem;">({count})</span>
          </a>
        ))}
        <a
          href="/categories/"
          style="font-size: 0.8rem; font-weight: 600; color: var(--accent); padding-left: 0.35rem;"
        >
          Semua Kategori &rarr;
        </a>
      </div>
    )}

    <!-- Posts Feed Header with Sorting Controls -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.75rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-size: 1.4rem; font-weight: 800; letter-spacing: -0.015em; margin: 0 0 0.25rem 0;">
          Daftar Artikel & Catatan
        </h2>
        <p style="font-size: 0.84rem; color: var(--text-muted); margin: 0;">
          Menampilkan <strong>{totalPosts}</strong> tulisan dan timeline terbagi per tahun.
        </p>
      </div>

      <!-- Sorting Toggle Controls -->
      <div class="archive-controls">
        <span style="font-size: 0.84rem; font-weight: 600; color: var(--text-muted);">Urutan:</span>
        <div class="archive-sort-group" role="group" aria-label="Urutan Beranda">
          <button
            type="button"
            id="home-sort-asc-btn"
            class="archive-sort-btn active"
            data-order="asc"
            aria-pressed="true"
            title="Urutkan dari artikel terlama ke terbaru (Older First)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
            <span>Terlama Dulu</span>
          </button>
          <button
            type="button"
            id="home-sort-desc-btn"
            class="archive-sort-btn"
            data-order="desc"
            aria-pressed="false"
            title="Urutkan dari artikel terbaru ke terlama"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
            <span>Terbaru Dulu</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Feed Grouped by Year -->
    <div id="home-feed-timeline" style="display: flex; flex-direction: column; gap: 2.75rem;">
      {sortedYears.map((year) => (
        <section id={`year-${year}`} class="home-year-section" data-year={year} style="scroll-margin-top: 5rem;">
          <!-- Year Header -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.6rem;">
            <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
              <h3 style="font-size: 1.75rem; font-weight: 800; color: var(--accent); margin: 0; line-height: 1;">
                {year}
              </h3>
              <div style="display: inline-flex; align-items: center; gap: 0.35rem;" title={`Blog & Timeline aktif di tahun ${year}`}>
                {yearSources[year] && yearSources[year].map((src) => {
                  const info = getSourceInfo(src);
                  return (
                    <a
                      href={`/source/${info.slug}/`}
                      class="source-dot-link"
                      title={`Blog ${year}: ${info.name}`}
                      aria-label={`Blog ${year}: ${info.name}`}
                    >
                      <span class={`source-dot ${info.dotClass}`}></span>
                    </a>
                  );
                })}
                {yearHasTimeline[year] && (
                  <span class="source-dot-link" title={`Terdapat catatan Timeline di tahun ${year}`} aria-label={`Timeline ${year}`}>
                    <span class="source-dot dot-timeline"></span>
                  </span>
                )}
              </div>
              <span style="font-size: 0.82rem; color: var(--text-muted); background-color: var(--bg-hover); padding: 0.2rem 0.6rem; border-radius: var(--radius-full); font-weight: 500;">
                {postsByYear[year].length} entri
              </span>
            </div>

            <a href={`/archives/#year-${year}`} style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-decoration: none;" class="hover:text-[var(--accent)]">
              Buka Arsip {year} &rarr;
            </a>
          </div>

          <!-- Posts Grid for this Year -->
          <div class="posts-grid home-year-posts">
            {postsByYear[year].map((post) => (
              <PostCard
                title={post.data.title}
                slug={post.data.slug}
                date={post.data.date}
                source={post.data.source || 'takien.com'}
                categories={post.data.categories}
                tags={post.data.tags}
                isTimeline={post.data.isTimeline}
                isFresh={post.data.isFresh}
                commentsCount={post.data.comments?.length || 0}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      const container = document.getElementById('home-feed-timeline');
      const btnDesc = document.getElementById('home-sort-desc-btn');
      const btnAsc = document.getElementById('home-sort-asc-btn');

      if (!container || !btnDesc || !btnAsc) return;

      function setHomeOrder(order, updateUrl = true) {
        const isAsc = order === 'asc';

        // Update button states
        if (isAsc) {
          btnAsc.classList.add('active');
          btnAsc.setAttribute('aria-pressed', 'true');
          btnDesc.classList.remove('active');
          btnDesc.setAttribute('aria-pressed', 'false');
        } else {
          btnDesc.classList.add('active');
          btnDesc.setAttribute('aria-pressed', 'true');
          btnAsc.classList.remove('active');
          btnAsc.setAttribute('aria-pressed', 'false');
        }

        // Reorder year sections
        const yearSections = Array.from(container.querySelectorAll('.home-year-section'));
        yearSections.sort((a, b) => {
          const yearA = a.getAttribute('data-year') || '';
          const yearB = b.getAttribute('data-year') || '';
          return isAsc ? yearA.localeCompare(yearB) : yearB.localeCompare(yearA);
        });

        // Reorder post cards inside each year
        yearSections.forEach((section) => {
          const postsContainer = section.querySelector('.home-year-posts');
          if (postsContainer) {
            const postCards = Array.from(postsContainer.querySelectorAll('.post-card'));
            postCards.sort((a, b) => {
              const dateA = a.getAttribute('data-date') || '';
              const dateB = b.getAttribute('data-date') || '';
              return isAsc ? dateA.localeCompare(dateB) : dateB.localeCompare(dateA);
            });
            postCards.forEach((card) => postsContainer.appendChild(card));
          }
          container.appendChild(section);
        });

        // Update URL parameter
        if (updateUrl) {
          try {
            const url = new URL(window.location.href);
            if (!isAsc) {
              url.searchParams.set('order', 'desc');
            } else {
              url.searchParams.delete('order');
            }
            window.history.replaceState(null, '', url.toString());
          } catch (e) {}
        }
      }

      btnDesc.addEventListener('click', () => setHomeOrder('desc'));
      btnAsc.addEventListener('click', () => setHomeOrder('asc'));

      // Check initial URL param
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const initialOrder = urlParams.get('order');
        if (initialOrder === 'desc' || initialOrder === 'newest') {
          setHomeOrder('desc', false);
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
