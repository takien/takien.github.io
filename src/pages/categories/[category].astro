---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categoriesMap = new Map<string, { name: string; posts: any[] }>();

  posts.forEach((p) => {
    p.data.categories?.forEach((c: string) => {
      const slug = slugify(c);
      if (!slug) return;
      if (!categoriesMap.has(slug)) {
        categoriesMap.set(slug, { name: c, posts: [] });
      }
      categoriesMap.get(slug)!.posts.push(p);
    });
  });

  return Array.from(categoriesMap.entries()).map(([slug, data]) => {
    const sorted = data.posts.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
    return {
      params: { category: slug },
      props: { category: data.name, posts: sorted },
    };
  });
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`Kategori: ${category} • takien.com`}
  description={`Daftar artikel dalam kategori ${category} di blog takien.com`}
>
  <div class="container">
    <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
      <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">
        Kategori
      </div>
      <div class="prose max-w-none">
        <h1>
          {category}
        </h1>
      </div>
      <p style="color: var(--text-secondary); font-size: 1rem;">
        Menampilkan <strong>{posts.length}</strong> artikel dalam kategori ini.
      </p>
    </div>

    <div class="posts-grid">
      {posts.map((post: any) => (
        <PostCard
          title={post.data.title}
          slug={post.data.slug}
          date={post.data.date}
          source={post.data.source || 'takien.com'}
          categories={post.data.categories}
          tags={post.data.tags}
          isTimeline={post.data.isTimeline}
          isFresh={post.data.isFresh}
          commentsCount={post.data.comments?.length || 0}
        />
      ))}
    </div>
  </div>
</BaseLayout>
