---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts');
const jsPosts = allPosts.filter((p) => {
  const t = p.data.title.toLowerCase();
  const c = p.data.categories?.map((x: string) => x.toLowerCase()).join(' ') || '';
  const tg = p.data.tags?.map((x: string) => x.toLowerCase()).join(' ') || '';
  return t.includes('jquery') || t.includes('javascript') || t.includes('fakeselect') || c.includes('jquery') || tg.includes('jquery') || tg.includes('javascript');
}).sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
---

<BaseLayout
  title="JavaScript & jQuery Plugins • takien.com"
  description="Koleksi plugin jQuery dan eksperimen JavaScript di takien.com"
>
  <div class="container">
    <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
      <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">
        Koleksi Skrip
      </div>
      <div class="prose max-w-none">
        <h1>
          JavaScripts & jQuery Plugins
        </h1>
      </div>
      <p style="color: var(--text-secondary); font-size: 1.05rem; max-width: 680px;">
        Kumpulan skrip jQuery, tips manipulasi DOM, dan plugin antarmuka buatan takien (FakeSelect, scrollbar styling, tooltip, dll).
      </p>
    </div>

    <div class="posts-grid">
      {jsPosts.map((post) => (
        <PostCard
          title={post.data.title}
          slug={post.data.slug}
          date={post.data.date}
          source={post.data.source || 'takien.com'}
          categories={post.data.categories}
          tags={post.data.tags}
          commentsCount={post.data.comments?.length || 0}
        />
      ))}
    </div>
  </div>
</BaseLayout>
